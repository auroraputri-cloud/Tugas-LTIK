# 1. Data Nilai Maksimum Mahasiswa
nilai = [88, 75, 63, 97, 82, 74, 91, 80, 81, 63]

# a. Nilai maksimum, minimum, dan rata-rata
nilaiMaksimum = max(nilai)
nilaiMinimum = min(nilai)
nilaiRataRata = sum(nilai) / len(nilai)

print("Aurora Putri Novrizcha -2605749")
print("Nilai Maksimum : ", nilaiMaksimum)
print("Nilai Minimum :", nilaiMinimum)
print("Nilai Rata-Rata : ", nilaiRataRata)

# b. Angka Terbesar Kedua
nilai.remove(nilaiMaksimum)
terbesarKedua = max(nilai)

print("Angka Terbesar Kedua: ", terbesarKedua)

